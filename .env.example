# Copy to .env and fill in what you have. Every key is optional:
# a missing key switches that integration to its local mock (shown in the UI).

# Claude (pick one)
ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=claude-haiku-5-5
# Or via AWS Bedrock (uses your AWS credentials from the environment):
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL=
# AWS_REGION=us-east-1

# Daytona
DAYTONA_API_KEY=

# Anchor Browser (+ the public URL of this app so the cloud browser can read /site)
ANCHOR_BROWSER_API_KEY=
PUBLIC_BASE_URL=

# ElevenLabs
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Arize AX
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# ARIZE_PROJECT=jarvis-dispatch
# ARIZE_TRANSPORT=grpc   # set to http if the venue wifi blocks gRPC

# SurrealDB: embedded by default (no account). For SurrealDB Cloud:
# SURREAL_URL=wss://<your-instance>/rpc
# SURREAL_USER=
# SURREAL_PASS=
